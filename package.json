{
  "name": "dividend-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:seo": "tsx --test \"lib/seo/**/*.test.ts\" \"lib/news/**/*.test.ts\" \"lib/i18n/**/*.test.ts\"",
    "test:divbrain": "tsx --test \"lib/divbrain/**/*.test.ts\"",
    "test:divbrain:context": "tsx --test \"lib/divbrain/server/context/**/*.test.ts\"",
    "test:cursor-bridge": "tsx --test \"lib/cursor-bridge/**/*.test.ts\"",
    "test:db": "node --experimental-strip-types --test tests/database/*.db.test.ts",
    "test:db:migration": "node scripts/test-legacy-duplicate-migration.mjs",
    "test:browser": "node scripts/verify-public-experience.mjs",
    "test:browser:auth": "node scripts/verify-browser-flows.mjs",
    "test:browser:all": "node scripts/verify-public-experience.mjs && node scripts/verify-browser-flows.mjs",
    "test:all": "npm test && npm run test:seo && npm run test:db && npm run test:divbrain && npm run test:cursor-bridge",
    "typecheck": "tsc --noEmit",
    "divbrain:provider-benchmark:live": "tsx scripts/divbrain-provider-benchmark.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.56",
    "decimal.js-light": "^2.5.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.2",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
