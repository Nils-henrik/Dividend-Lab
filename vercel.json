{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "cursor/issue-*": false,
      "autoredaktion/*": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/company-ingestion/run",
      "schedule": "17 3 * * *"
    }
  ],
  "env": {
    "MODEL_PORTFOLIO_DRY_RUN_ENABLED": "true",
    "MODEL_PORTFOLIO_EXECUTION_ENABLED": "true"
  }
}
